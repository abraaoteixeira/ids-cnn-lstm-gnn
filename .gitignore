# ============================================================
# SPECTRE_GRID — .gitignore
# ============================================================

# === Ambientes Python ===
.venv*/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
*.egg

# === Build / Compilação C++ & Rust ===
build/
target/
loader_fusion_rs/target/
*.o
*.so
*.a
CMakeCache.txt
CMakeFiles/

# === Modelos Treinados (grandes, versionados separadamente) ===
*.pt
*.pth
!data/processed/top20_features.json

# === Temporários do Sistema ===
.tmp.drivedownload/
.tmp.driveupload/
*.deb

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === Releases empacotados ===
*.zip

# === Logs & Outputs ===
*.log
data/logs/*.log
data/processed/confusion_matrix.png
.aider*

# === Segurança, Credenciais e Propriedade Intelectual (NIT/INPI) ===
*.pem
*.key
*.priv
*.id_rsa
*.id_ed25519
*.wireguard
wg*.conf
gcp_credentials*.json
*secret*
*token*
*nit*draft*
*patente*
*formulario_nit*

# === Datasets Brutos e Compactados (proibido enviar ao GitHub) ===
*.csv
*.gz
